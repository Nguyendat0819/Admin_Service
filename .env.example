# ============================================================
#  Environment variables template — copy thành .env và điền giá trị thật
#  Lưu ý: KHÔNG commit file .env vào git (đã có trong .gitignore)
# ============================================================

# ---- Server ----
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/

# ---- Spring profile ----
SPRING_PROFILES_ACTIVE=dev

# ---- Database (PostgreSQL) ----
DB_URL=jdbc:postgresql://localhost:5432/java_template
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- JPA ----
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ---- Keycloak OAuth2 ----
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/platform
KEYCLOAK_JWKS_URI=http://localhost:8180/realms/platform/protocol/openid-connect/certs
KEYCLOAK_BASE_URL=http://localhost:8180

# ---- Logging ----
LOG_DIR=logs
LOG_FILE_NAME=application
