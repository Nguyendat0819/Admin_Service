# ============================================================
#  Lombok configuration — tắt warning, tối ưu build
#  https://projectlombok.org/features/configuration
# ============================================================

# Tự động thêm @Generated annotation cho tất cả lombok-generated methods
config.stopBubbling = true

# Tắt cảnh báo "equals/hashCode không override equals chỉ dựa trên các trường final"
# Giúp tránh warning trong IDE khi dùng @Data + @FieldDefaults
lombok.equalsAndHashCode.callSuper = call

# Cho phép @Builder với class có @FieldDefaults
# (mặc định lombok bỏ qua field default scope = PACKAGE; ép dùng cả private)
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Autowired
